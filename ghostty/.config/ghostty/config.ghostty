# FiraCode Font Family
font-family = FiraCode Nerd Font

# Opacity
background-opacity = 0.9

# Cursor Style
cursor-style = block_hollow
cursor-color = #37e57b

# Tokyo Night — Storm variant (most popular)
background = #24283b
foreground = #c0caf5

selection-background = #364a82
selection-foreground = #c0caf5

# Normal colors (0–7)
palette = 0=#1d202f
palette = 1=#f7768e
palette = 2=#9ece6a
palette = 3=#e0af68
palette = 4=#7aa2f7
palette = 5=#bb9af7
palette = 6=#7dcfff
palette = 7=#a9b1d6

# Bright colors (8–15)
palette = 8=#414868
palette = 9=#f7768e
palette = 10=#9ece6a
palette = 11=#e0af68
palette = 12=#7aa2f7
palette = 13=#bb9af7
palette = 14=#7dcfff
palette = 15=#c0caf5