#!/bin/bash
# Update the Tailscale-sidecar stacks on the NAS.
# The UGOS update button recreates containers one at a time, which strands each
# app on a dead sidecar network. So: pull everything, then down/up whole stacks.
# AdGuard goes last: it's the house DNS, and the pulls need DNS.
# Main Immich stack is deliberately excluded (read release notes, update by hand).
set -euo pipefail

ROOT=/volume1/docker
STACKS=(vaultwarden linkding immich-share immich-ts diun actual ghostfolio adguard)

for s in "${STACKS[@]}"; do
  echo "==> pulling $s"
  (cd "$ROOT/$s" && sudo docker compose pull)
done

for s in "${STACKS[@]}"; do
  echo "==> recreating $s"
  (cd "$ROOT/$s" && sudo docker compose down && sudo docker compose up -d)
done

echo "==> removing old images"
sudo docker image prune -f

echo
sudo docker ps --format 'table {{.Names}}\t{{.Image}}\t{{.Status}}'

# The NAS's own tailnet node (host network, made in the UGOS UI) isn't a compose
# stack, so it isn't recreated above and stays on the old image. Diun won't
# re-alert for it, so warn here. Update it via the UGOS UI from the LAN only:
# it's the remote way in, and if it doesn't come back you're locked out.
NODE=tailscale_tailscale-1
node_img=$(sudo docker inspect "$NODE" --format '{{.Image}}' 2>/dev/null || true)
latest_img=$(sudo docker image inspect tailscale/tailscale:latest --format '{{.Id}}' 2>/dev/null || true)
if [[ -n $node_img && -n $latest_img && $node_img != "$latest_img" ]]; then
  echo
  echo "!!  $NODE is on an older tailscale image than the sidecars."
  echo "    Update it in the UGOS Docker UI, from the LAN, not over Tailscale."
fi
